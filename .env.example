# Aedes Data Lab: modelo de configuração
#
# Copie este arquivo para .env.local e preencha com os valores do projeto Supabase
# do ambiente que estiver usando (local, prévia ou produção). O .env.local nunca
# vai para o Git. Veja docs/ARCHITECTURE.md, seção 8, e docs/SECURITY.md, seção 8.

# Ambiente atual: local, previa ou producao
AEDES_AMBIENTE=local

# Projeto Supabase (Project Settings > API). No ambiente local, use os valores
# que o comando "supabase start" mostra.
SUPABASE_URL=
# Chave pública (publishable, antiga anon). Pode ir para o site: o acesso é
# limitado pelas políticas de RLS.
SUPABASE_PUBLISHABLE_KEY=

# Provedor da camada visual do mapa (definido em DEP-07)
MAPA_PROVEDOR_URL=
MAPA_PROVEDOR_CHAVE=

# Usadas só pelas Edge Functions, cadastradas como segredos do projeto.
# Nunca no código do site.
SUPABASE_SECRET_KEY=
EMAIL_REMETENTE=
EMAIL_SERVICO_CHAVE=
