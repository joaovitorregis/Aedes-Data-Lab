# Aedes Data Lab: modelo de configuração
#
# Copie este arquivo para .env.local e preencha com os valores do projeto Firebase
# do ambiente que estiver usando (teste, prévia ou produção). O .env.local nunca
# vai para o Git. Veja docs/ARCHITECTURE.md, seção 8, e docs/SECURITY.md, seção 8.

# Ambiente atual: local, previa ou producao
AEDES_AMBIENTE=local

# Usar o Firebase Emulator Suite em vez do projeto na nuvem (true ou false)
AEDES_USAR_EMULADORES=true

# Configuração web do Firebase (Configurações do projeto > Seus apps)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Provedor da camada visual do mapa (definido em DEP-07)
MAPA_PROVEDOR_URL=
MAPA_PROVEDOR_CHAVE=

# Usadas só pelas Cloud Functions, nunca no código do site
EMAIL_REMETENTE=
EMAIL_SERVICO_CHAVE=
