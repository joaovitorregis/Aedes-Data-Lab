{
  "rewrites": [
    {"source": "/", "destination": "/inicio.html"},
    {"source": "/agentes", "destination": "/agentes/index.html"},
    {"source": "/agentes/ocorrencias", "destination": "/agentes/ocorrencias.html"},
    {"source": "/agentes/ocorrencia", "destination": "/agentes/ocorrencia.html"},
    {"source": "/agentes/arquivadas", "destination": "/agentes/arquivadas.html"},
    {"source": "/agentes/visita", "destination": "/agentes/visita.html"},
    {"source": "/agentes/correcao", "destination": "/agentes/correcao.html"},
    {"source": "/agentes/relatorio", "destination": "/agentes/relatorio.html"}
  ],
  "redirects": [
    {"source": "/agentes/Login.html", "destination": "/agentes", "permanent": false},
    {"source": "/agentes/dashboard.html", "destination": "/agentes/ocorrencias", "permanent": false},
    {"source": "/agentes/dashboard", "destination": "/agentes/ocorrencias", "permanent": false},
    {"source": "/agentes/meu-trabalho.html", "destination": "/agentes/ocorrencias", "permanent": false},
    {"source": "/agentes/meu-trabalho", "destination": "/agentes/ocorrencias", "permanent": false},
    {"source": "/agentes/mapa.html", "destination": "/agentes/ocorrencias?vista=mapa", "permanent": false},
    {"source": "/agentes/mapa", "destination": "/agentes/ocorrencias?vista=mapa", "permanent": false}
  ],
  "headers": [
    {
      "source": "/agentes(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://unpkg.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://tile.openstreetmap.org; connect-src 'self' blob: https://zewujnphltpoiowtmlsq.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
